#!/bin/sh
# canireach entry — find Bun and exec src/cli.ts.
set -e

# Resolve symlinks so we work when installed via npm's bin/.
self=$0
while [ -L "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case "$self" in
    /*) ;;
    *) self="$dir/$self" ;;
  esac
done
here=$(cd -P "$(dirname "$self")" && pwd)
cli="$here/../src/cli.ts"

if command -v bun >/dev/null 2>&1; then
  bun_bin=bun
elif [ -x "$HOME/.bun/bin/bun" ]; then
  bun_bin="$HOME/.bun/bin/bun"
else
  echo "canireach requires Bun. Install it with:" >&2
  echo "  curl -fsSL https://bun.sh/install | bash" >&2
  exit 1
fi

exec "$bun_bin" "$cli" "$@"
