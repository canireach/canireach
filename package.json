{
  "name": "canireach",
  "version": "0.3.3",
  "description": "Local network + AI-service reachability monitor. TUI by default; --web for a Chart.js dashboard. Works with either Node or Bun.",
  "keywords": [
    "network",
    "monitor",
    "tui",
    "dashboard",
    "ai",
    "reachability",
    "proxy"
  ],
  "author": "canireach",
  "license": "MIT",
  "homepage": "https://github.com/canireach/canireach",
  "repository": {
    "type": "git",
    "url": "https://github.com/canireach/canireach.git"
  },
  "bugs": {
    "url": "https://github.com/canireach/canireach/issues"
  },
  "type": "module",
  "bin": {
    "canireach": "./dist/canireach.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "bun src/cli.ts",
    "tui": "bun src/cli.ts",
    "web": "bun src/cli.ts --web",
    "once": "bun src/cli.ts --once",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {}
}
